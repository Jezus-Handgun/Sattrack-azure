# Skopiuj do .env, jeśli chcesz zmienić wartości domyślne. Wszystkie zmienne są opcjonalne.

# Jak długo (w sekundach) dane TLE z CelesTrak są uznawane za świeże. Nie ustawiaj mniej niż 7200.
TLE_TTL_SECONDS=7200
# Katalog na pobrane pliki TLE (cache między zapytaniami)
TLE_CACHE_DIR=/tmp/tle
# Domyślny punkt obserwacji (Chorzów)
DEFAULT_LAT=50.30
DEFAULT_LON=18.95
# Maska elewacji: satelity niżej nad horyzontem są pomijane [stopnie]
MIN_ELEVATION_DEG=10
# Poziom logowania: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
